# Server Port & Environment
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/mandi-mood
# MongoDB Atlas (Cloud) example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mandi-mood?retryWrites=true&w=majority

# Security: Admin API Passkey for rate mutations (POST/PUT/DELETE /rates, POST /reset)
ADMIN_API_KEY=apmc-vashi-secret-2026

# Security: Allowed CORS Origins (comma-separated or * for wildcard)
ALLOWED_ORIGIN=*
